# Set the API key for the provider you use
ANTHROPIC_API_KEY=your_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MOONSHOT_API_KEY=your_kimi_api_key_here
ZAI_API_KEY=your_glm_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
DASHSCOPE_API_KEY=your_qwen_api_key_here
XAI_API_KEY=your_grok_api_key_here

# Qwen only: use this endpoint for an API key issued in mainland China
# DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1

# LangSmith (optional - for tracing and monitoring)
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=text2sql-deepagent

# Tavily API (optional - for web search capabilities)
TAVILY_API_KEY=your_tavily_api_key_here
